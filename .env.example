# Do not commit real secrets. Keep real values in local .env only.
BALE_BOT_TOKEN=YOUR_BALE_BOT_TOKEN
BALE_API_BASE_URL=https://tapi.bale.ai
# Safety default: keep false unless you explicitly want real outgoing messages.
BALE_ENABLE_SENDING=false
BALE_REPLY_TEXT=پیام شما دریافت شد. این ربات جایگزین نظر داروساز یا پزشک نیست. در صورت نیاز، پیام شما توسط داروساز بررسی می‌شود.
DATABASE_PATH=bale_bot.db
# Secret segment for webhook route: /webhook/bale/{secret}
BALE_WEBHOOK_SECRET=CHANGE_ME
# Safety default: do not store complete raw webhook payloads unless explicitly needed for debugging.
BALE_STORE_RAW_UPDATES=false
# Optional pharmacist/admin review notification target. Keep disabled until tested.
BALE_ADMIN_CHAT_ID=
BALE_ENABLE_ADMIN_NOTIFICATIONS=false
# Optional LLM classification layer (Milestone 9). Keep disabled until pharmacist-approved go-live.
BALE_ENABLE_LLM=false
# shadow = persist LLM fields only; live = LLM can escalate review (never downgrade keyword hits).
BALE_LLM_MODE=shadow
# Arvan Cloud AI (Iran VPS): put gateway token in URL — see docs/agents/HANDOFF.md
# BALE_LLM_API_BASE_URL=https://arvancloudai.ir/gateway/models/DeepSeek-V3.2/<token-from-panel>/v1
BALE_LLM_API_BASE_URL=
# Use panel API key, or "arvan" when auth is embedded in BALE_LLM_API_BASE_URL
BALE_LLM_API_KEY=
BALE_LLM_MODEL=DeepSeek-V3.2
BALE_LLM_TIMEOUT_SECONDS=90

# ─────────────────────────────────────────────────────────────────────────────
# [PHASE 6] bale-panel Shadow Emitter
# ارسال shadow record به bale-panel پس از هر پاسخ LLM
# مستندات: docs/api-contract.md در مخزن bale-panel
# ─────────────────────────────────────────────────────────────────────────────

# فعال‌سازی ارسال به پنل (Safety default: false — پس از تست local فعال کنید)
PANEL_EMIT_ENABLED=false

# آدرس پایه bale-panel — بدون slash انتهایی
# محیط local:      http://localhost:3000
# محیط production: https://panel.embednet.ir  (یا IP/port سرور)
PANEL_BASE_URL=http://localhost:3000

# Bearer token — مقدار PANEL_API_SECRET از .env فایل bale-panel
# تولید: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# هر دو فایل .env باید مقدار یکسانی داشته باشند.
PANEL_OPERATOR_TOKEN=CHANGE_ME_MUST_MATCH_PANEL_API_SECRET

# Timeout ارسال HTTP به پنل (ثانیه). شکست emit کار اصلی ربات را متوقف نمی‌کند.
PANEL_EMIT_TIMEOUT=5
